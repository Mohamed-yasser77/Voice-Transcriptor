{
  "productName": "Voice Transcriptor",
  "version": "0.1.0",
  "identifier": "com.voicetranscriptor.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voice Transcriptor",
        "width": 340,
        "height": 280,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "externalBin": ["../sidecar/whisper_server"]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
